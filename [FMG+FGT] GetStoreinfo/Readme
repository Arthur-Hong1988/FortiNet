# Tunnel_status_check.py
# 处理get vpn ipsec tunnel summary命令输出
'Tunnel1' 118.143.78.53:0  selectors(total,up): 1/0  rx(pkt,err): 0/0  tx(pkt,err): 0/0
'Tunnel2' 118.143.56.203:4500  selectors(total,up): 1/1  rx(pkt,err): 1567/0  tx(pkt,err): 3823/1
'Tunnel3' 203.127.132.72:0  selectors(total,up): 1/0  rx(pkt,err): 0/0  tx(pkt,err): 0/0
'Tunnel4' 118.201.206.60:4500  selectors(total,up): 1/1  rx(pkt,err): 41562/0  tx(pkt,err): 57864/0

 pattern = r"'([^']+)'.*?selectors\(total,up\):\s*\d+/(\d+)"
'([^']+)'     .*?     selectors\(total,up\):     \s*     \d+     /     (\d+)
   ↓           ↓               ↓                  ↓       ↓             ↓
Tunnel名称    中间任意内容     固定文字              空格    total            up
^'：在 [] 里面表示“不是单引号”

